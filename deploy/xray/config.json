{
  "log": { "loglevel": "warning" },
  "api": {
    "tag": "api",
    "listen": "/run/xray/api.sock,0660",
    "services": ["HandlerService"]
  },
  "inbounds": [
    {
      "tag": "vless-reality",
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "target": "example.com:443",
          "serverNames": ["example.com"],
          "privateKey": "EXAMPLE-REPLACE-WITH-XRAY-X25519-PRIVATE-00",
          "shortIds": ["0123456789abcdef"]
        }
      }
    }
  ],
  "outbounds": [
    { "tag": "direct", "protocol": "freedom" }
  ]
}
