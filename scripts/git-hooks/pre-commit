#!/usr/bin/env bash
# Enable per clone: git config core.hooksPath scripts/git-hooks
# Runs under bash 3.2 (macOS). Checks the working tree, not only the staged content.
set -euo pipefail

branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
if [[ "$branch" == "master" || "$branch" == "main" ]]; then
  echo "pre-commit: direct commit to '$branch' is forbidden; branch first:" >&2
  echo "  git switch -c <feature-name> origin/master" >&2
  exit 1
fi

cd "$(git rev-parse --show-toplevel)"

if [[ -z "$(git diff --cached --name-only --diff-filter=ACMR -- '*.go')" ]]; then
  exit 0
fi

scripts/format.sh
